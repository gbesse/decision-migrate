{
  "name": "@gbesse/decision-migrate",
  "description": "Inspect and migrate finite Dify classifiers to Jev with reviewable patches and measured comparisons.",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "web",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/decision-migrate.git"
  },
  "dependencies": {
    "@gbesse/decision-workbench": "git+https://github.com/gbesse/decision-workbench.git#161f55c637cbcb666b67449b0bbbbee52c393684",
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461",
    "yaml": "2.9.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "start": "node src/server.mjs",
    "demo": "node src/server.mjs --demo",
    "demo:patch": "node examples/patch-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
